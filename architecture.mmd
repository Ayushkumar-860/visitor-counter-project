graph TD
    %% ═══════════════════════════════════════════════════════
    %% Architecture Diagram — Visitor Counter Cloud Project
    %% ═══════════════════════════════════════════════════════

    Browser["🌐 Browser / Client"]
    Gateway["🔀 Failover Gateway\n(failover/gateway.py)\nPort 8080"]

    subgraph Docker["🐳 Docker Compose (Local Dev)"]
        FC["Flask-App Container\nGunicorn · Port 5000"]
        RC["Redis Container\nPort 6379"]
        VOL[("💾 redis-data\nNamed Volume")]
        FC --> RC
        RC --> VOL
    end

    subgraph ClusterA["☸️ Minikube: private-cluster"]
        direction TB
        subgraph NSA["Namespace: visitor-counter"]
            HPA_A["📈 HPA\n(2–5 replicas)"]
            MS_A["📊 Metrics Server"]
            Flask1["Flask Pod 1"]
            Flask2["Flask Pod 2"]
            FlaskN["Flask Pod N (scaled)"]
            SVC_A["Service: flask-service\nNodePort :30080"]
            Redis_A["Redis Pod"]
            RedisSVC_A["Service: redis-service\nClusterIP"]
            PVC_A[("💾 PVC: redis-pvc\n100Mi")]
            CM_A["ConfigMap"]

            MS_A --> HPA_A
            HPA_A --> Flask1
            HPA_A --> Flask2
            HPA_A --> FlaskN
            Flask1 --> RedisSVC_A
            Flask2 --> RedisSVC_A
            FlaskN --> RedisSVC_A
            RedisSVC_A --> Redis_A
            Redis_A --> PVC_A
            CM_A --> Flask1
            SVC_A --> Flask1
            SVC_A --> Flask2
            SVC_A --> FlaskN
        end
    end

    subgraph ClusterB["☸️ Minikube: public-cluster (Simulated)"]
        direction TB
        subgraph NSB["Namespace: visitor-counter"]
            Flask_B["Flask Pods\n(Replicas)"]
            SVC_B["Service: flask-service\nNodePort :30080"]
            Redis_B["Redis Pod\n(Independent State)"]
            SVC_B --> Flask_B
            Flask_B --> Redis_B
        end
    end

    subgraph LoadTest["🔥 Load Testing"]
        LT["load-test/load_test.py\nHTTP flood → triggers HPA"]
    end

    subgraph Tests["🧪 Tests (pytest)"]
        UT["tests/test_app.py\nfakeredis · 16 tests"]
    end

    Browser --> Gateway
    Gateway -->|"Primary"| SVC_A
    Gateway -->|"Failover (health-check)"| SVC_B
    Browser --> Docker
    LT --> SVC_A
    UT --> FC

    classDef cluster fill:#1e293b,stroke:#4f46e5,color:#f1f5f9
    classDef service fill:#0f172a,stroke:#06b6d4,color:#f1f5f9
    classDef redis fill:#0f172a,stroke:#ef4444,color:#f1f5f9
    classDef hpa fill:#0f172a,stroke:#22c55e,color:#f1f5f9
    classDef test fill:#1e293b,stroke:#f59e0b,color:#f1f5f9
